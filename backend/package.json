{
  "name": "journal-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.js",
    "dev:mock": "FIREBASE_USE_LOCAL=true tsx watch src/server.js",
    "dev:local": "FIREBASE_USE_EMULATORS=true FIREBASE_PROJECT_ID=demo-bards-journal tsx watch src/server.js",
    "typecheck": "tsc --noEmit",
    "build": "tsc --allowJs --checkJs --noEmit false --outDir dist src/server.js",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "firebase-admin": "^13.0.2"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
